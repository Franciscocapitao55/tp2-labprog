</pre>

</div>

</body>

</html>
"""

# PDF

def generate_pdf_report(summary, raw_text, cleaned_text):
    filename = "relatorio_pipeline.pdf"

    doc = SimpleDocTemplate(filename)

    styles = getSampleStyleSheet()

    elements = []

    elements.append(
        Paragraph(
            "🧠 Relatório TextMind AI",
            styles['Title']
        )
    )

    elements.append(Spacer(1, 20))

    elements.append(
        Paragraph(
            str(summary),
            styles['BodyText']
        )
    )

    elements.append(Spacer(1, 20))

    elements.append(
        Paragraph(
            raw_text,
            styles['BodyText']
        )
    )

    elements.append(Spacer(1, 20))

    elements.append(
        Paragraph(
            cleaned_text,
            styles['BodyText']
        )
    )

    doc.build(elements)

    return filename
